* text=auto
*.py text eol=lf
*.c text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.cfg text eol=lf
*.md text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
LICENSE text eol=lf

# Keep pinned dependency and patch hashes identical after cloning.
reference/** -text -whitespace
patches/**/*.patch -text -whitespace
config/windows.manifest -text whitespace=cr-at-eol
