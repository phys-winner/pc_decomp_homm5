<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="org.homm5.port"
    android:versionCode="7" android:versionName="0.3.2-dev">
  <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="37" />
  <uses-feature android:glEsVersion="0x00030002" android:required="true" />
  <!-- Android 8-10 read the game's files and keep the saves in /sdcard/HeroesV with these (asked for by
       the launcher); Android 11+ with All files access, which the launcher base declares. -->
  <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
  <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <!-- The LAN game: UDP sockets, broadcast discovery over Wi-Fi. -->
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
  <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
  <!-- launcher:manifest -->
  <!-- requestLegacyExternalStorage: Android 10 reads the game's files by path only in the legacy view. -->
  <application android:label="Heroes V" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher"
      android:appCategory="game" android:debuggable="true" android:allowBackup="false"
      android:extractNativeLibs="true" android:requestLegacyExternalStorage="true" android:hasCode="true"
      android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">
    <!-- launcher:application -->
    <!-- The home-screen entry is the launcher's (port.json, tools/build_game_apk.py). Tribes of the East
         runs in the main process; exported for the tools (am start of org.homm5.port/.GameActivity). -->
    <activity android:name=".GameActivity" android:exported="true" android:screenOrientation="sensorLandscape"
        android:windowSoftInputMode="adjustNothing"
        android:configChanges="orientation|screenSize|keyboardHidden|keyboard|navigation|screenLayout|uiMode"
        android:launchMode="singleTask" />
    <activity android:name=".VanillaGameActivity" android:exported="true" android:label="Heroes V"
        android:screenOrientation="sensorLandscape" android:windowSoftInputMode="adjustNothing"
        android:process=":vanilla" android:taskAffinity="org.homm5.port.vanilla"
        android:configChanges="orientation|screenSize|keyboardHidden|keyboard|navigation|screenLayout|uiMode"
        android:launchMode="singleTask" />
    <activity android:name=".HofGameActivity" android:exported="true" android:label="Hammers of Fate"
        android:screenOrientation="sensorLandscape" android:windowSoftInputMode="adjustNothing"
        android:process=":hof" android:taskAffinity="org.homm5.port.hof"
        android:configChanges="orientation|screenSize|keyboardHidden|keyboard|navigation|screenLayout|uiMode"
        android:launchMode="singleTask" />
  </application>
</manifest>
