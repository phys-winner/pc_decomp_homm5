# Publication allowlist. Machine settings, game inputs and new root folders stay private.
/*
!/.gitignore
!/.gitattributes
!/readme.md
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/dependencies.json
!/requirements.txt
!/port.example.json

!/android/
/android/**
!/android/**/
!/android/**/*.c
!/android/**/*.cpp
!/android/**/*.h
!/android/**/*.java
!/android/**/*.xml

!/native/
/native/*
!/native/*.c

!/config/
/config/*
!/config/modules.json
!/config/editions.json
!/config/*.modules.json
!/config/*.patches.json
!/config/*.jump-tables.json
!/config/windows.manifest
!/config/profiles/
!/config/video/
!/config/music/
/config/music/*
!/config/music/manifest.json
!/config/music/vanilla.json
!/config/music/hof.json
!/config/music/README.md

!/tools/
/tools/*
!/tools/*.py

!/tests/
/tests/**
!/tests/**/
!/tests/**/*.py
!/tests/**/*.c
!/tests/**/*.cpp
!/tests/**/*.h

!/patches/
!/reference/
/reference/*
!/reference/pcrecomp/
/reference/pcrecomp/*
!/reference/pcrecomp/LICENSE
!/reference/pcrecomp/tools/
/reference/pcrecomp/tools/*
!/reference/pcrecomp/tools/__init__.py
!/reference/pcrecomp/tools/disasm/
!/reference/pcrecomp/tools/lift/
!/reference/pcrecomp/tools/pe/
!/reference/pcrecomp/runtime/
/reference/pcrecomp/runtime/*
!/reference/pcrecomp/runtime/native32/
!/reference/pcrecomp/runtime/recomp32/
!/reference/mojoshader/
/reference/mojoshader/*
!/reference/mojoshader/LICENSE.txt
!/reference/mojoshader/*.h
!/reference/mojoshader/mojoshader.c
!/reference/mojoshader/mojoshader_common.c
!/reference/mojoshader/mojoshader_assembler.c
!/reference/mojoshader/mojoshader_preprocessor.c
!/reference/mojoshader/mojoshader_lexer.c
!/reference/mojoshader/profiles/
!/reference/mojoshader/spirv/
!/reference/dlmalloc/
!/reference/astcenc/
!/reference/etcpak/
!/reference/zlib/
!/reference/xz-embedded/

# Defense in depth, including dependency snapshots.
**/.git/
**/__pycache__/
**/.gradle/
**/build/
**/.idea/
**/.vscode/
*.py[cod]
*.apk
*.aab
*.exe
*.dll
*.so
*.o
*.obj
*.a
*.lib
*.pdb
*.class
*.dex
*.zip
*.7z
*.pak
*.sav
*.log
*.keystore
*.jks
*.pem
*.key
.env
.env.*
local.properties
port.json
STATE.md
AGENTS.md
